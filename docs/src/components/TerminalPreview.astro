---
// Interactive & animated CLI Terminal Preview for the Hero section
---

<div class="terminal-window" data-terminal>
  <div class="terminal-chrome">
    <div class="traffic-lights" aria-hidden="true">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>

    <div class="terminal-tabs" role="tablist" aria-label="PMM demo commands">
      <button type="button" class="term-tab active" role="tab" aria-selected="true" data-scene="scan">
        pmm scan
      </button>
      <button type="button" class="term-tab" role="tab" aria-selected="false" data-scene="diff">
        pmm diff
      </button>
      <button type="button" class="term-tab" role="tab" aria-selected="false" data-scene="sync">
        pmm sync
      </button>
    </div>

    <button type="button" class="replay-btn" data-replay title="Replay animation" aria-label="Replay terminal animation">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
        <path d="M3 3v5h5" />
      </svg>
      <span>Replay</span>
    </button>
  </div>

  <div class="terminal-body" aria-live="polite">
    <div class="term-command-line">
      <span class="prompt-symbol">$</span>
      <span class="typed-cmd" data-typed></span><span class="cursor" aria-hidden="true"></span>
    </div>
    <div class="term-output" data-output></div>
  </div>
</div>

<script is:inline>
  (() => {
    const scenes = {
      scan: {
        cmd: 'pmm scan',
        lines: [
          { html: '<span class="t-muted">Scanning local package managers...</span>', delay: 260 },
          { html: '<span class="t-ok">✓</span> <span class="t-key">apt</span>      <span class="t-muted">→</span> <span class="t-val">142 packages</span> <span class="t-muted">(Ubuntu 24.04)</span>', delay: 220 },
          { html: '<span class="t-ok">✓</span> <span class="t-key">brew</span>     <span class="t-muted">→</span> <span class="t-val"> 28 packages</span> <span class="t-muted">(Linuxbrew)</span>', delay: 180 },
          { html: '<span class="t-ok">✓</span> <span class="t-key">flatpak</span>  <span class="t-muted">→</span> <span class="t-val"> 11 packages</span>', delay: 180 },
          { html: '', delay: 120 },
          { html: '<span class="t-accent">Saved snapshot:</span> <span class="t-val">~/.pmm/snapshots/ubuntu-24.04.json</span>', delay: 200 },
        ],
      },
      diff: {
        cmd: 'pmm diff ubuntu-24.04 fedora-41',
        lines: [
          { html: '<span class="t-muted">Comparing</span> <span class="t-val">ubuntu-24.04</span> <span class="t-muted">vs</span> <span class="t-val">fedora-41</span>', delay: 240 },
          { html: '<span class="t-ok">✓</span> <span class="t-key">git, ripgrep, tmux, neovim, docker</span> <span class="t-muted">(already installed)</span>', delay: 220 },
          { html: '<span class="t-add">+</span> <span class="t-key">fd-find</span>   <span class="t-muted">missing on fedora-41</span> <span class="t-muted">→ dnf: fd-find</span>', delay: 200 },
          { html: '<span class="t-add">+</span> <span class="t-key">bat</span>       <span class="t-muted">missing on fedora-41</span> <span class="t-muted">→ dnf: bat</span>', delay: 180 },
          { html: '<span class="t-add">+</span> <span class="t-key">jq</span>        <span class="t-muted">missing on fedora-41</span> <span class="t-muted">→ dnf: jq</span>', delay: 180 },
          { html: '', delay: 100 },
          { html: '<span class="t-accent">Summary:</span> <span class="t-val">3 missing packages</span> <span class="t-muted">— run</span> <span class="t-key">pmm sync</span> <span class="t-muted">to install</span>', delay: 200 },
        ],
      },
      sync: {
        cmd: 'pmm sync --from ubuntu-24.04 --dry-run',
        lines: [
          { html: '<span class="t-muted">Resolving package mappings for</span> <span class="t-key">dnf</span><span class="t-muted">...</span>', delay: 260 },
          { html: '<span class="t-accent">Plan (dry-run):</span>', delay: 200 },
          { html: '  <span class="t-add">install</span> <span class="t-val">fd-find</span> <span class="t-muted">via dnf</span>', delay: 170 },
          { html: '  <span class="t-add">install</span> <span class="t-val">bat</span>     <span class="t-muted">via dnf</span>', delay: 160 },
          { html: '  <span class="t-add">install</span> <span class="t-val">jq</span>      <span class="t-muted">via dnf</span>', delay: 160 },
          { html: '', delay: 100 },
          { html: '<span class="t-ok">Ready!</span> <span class="t-muted">Re-run without</span> <span class="t-key">--dry-run</span> <span class="t-muted">to apply.</span>', delay: 200 },
        ],
      },
    };

    document.querySelectorAll('[data-terminal]').forEach((root) => {
      const typedEl = root.querySelector('[data-typed]');
      const outputEl = root.querySelector('[data-output]');
      const tabs = root.querySelectorAll('[data-scene]');
      const replayBtn = root.querySelector('[data-replay]');
      let currentScene = 'scan';
      let runId = 0;

      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

      async function play(sceneKey) {
        runId += 1;
        const myRun = runId;
        currentScene = sceneKey;
        const scene = scenes[sceneKey];
        if (!scene || !typedEl || !outputEl) return;

        tabs.forEach((t) => {
          const active = t.getAttribute('data-scene') === sceneKey;
          t.classList.toggle('active', active);
          t.setAttribute('aria-selected', String(active));
        });

        typedEl.textContent = '';
        outputEl.innerHTML = '';

        for (let i = 0; i < scene.cmd.length; i++) {
          if (myRun !== runId) return;
          typedEl.textContent += scene.cmd[i];
          await sleep(32 + Math.random() * 24);
        }

        for (const line of scene.lines) {
          if (myRun !== runId) return;
          await sleep(line.delay);
          if (myRun !== runId) return;
          const div = document.createElement('div');
          div.className = 'term-line';
          div.innerHTML = line.html || '&nbsp;';
          outputEl.appendChild(div);
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const key = tab.getAttribute('data-scene');
          if (key) play(key);
        });
      });

      replayBtn?.addEventListener('click', () => play(currentScene));
      play('scan');
    });
  })();
</script>

<style>
  .terminal-window {
    border-radius: var(--radius-xl);
    background: #0b1120;
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(56, 189, 248, 0.08);
    overflow: hidden;
    text-align: left;
  }

  .terminal-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: #0f172a;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }

  .traffic-lights {
    display: flex;
    align-items: center;
    gap: 0.42rem;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot-red {
    background: #ef4444;
  }
  .dot-yellow {
    background: #f59e0b;
  }
  .dot-green {
    background: #22c55e;
  }

  .terminal-tabs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: rgba(2, 6, 23, 0.55);
    padding: 0.2rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(148, 163, 184, 0.12);
  }

  .term-tab {
    border: none;
    background: transparent;
    color: #94a3b8;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.28rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .term-tab:hover {
    color: #e2e8f0;
  }

  .term-tab.active {
    background: rgba(56, 189, 248, 0.16);
    color: #38bdf8;
  }

  .replay-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: transparent;
    color: #94a3b8;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 500;
    padding: 0.28rem 0.55rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .replay-btn:hover {
    color: #f8fafc;
    border-color: rgba(148, 163, 184, 0.45);
  }

  .terminal-body {
    padding: 1.35rem 1.45rem 1.55rem;
    min-height: 235px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.75;
    color: #e2e8f0;
    overflow-x: auto;
  }

  .term-command-line {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.7rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .prompt-symbol {
    color: #38bdf8;
    font-weight: 700;
    user-select: none;
  }

  .typed-cmd {
    color: #f8fafc;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    background: #38bdf8;
    vertical-align: text-bottom;
    animation: blink 1s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  .term-output {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .terminal-body :global(.term-line) {
    white-space: pre;
    animation: termLineIn 0.22s ease both;
  }

  @keyframes termLineIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes termLineFade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-body :global(.term-line) {
      animation-name: termLineFade;
    }
  }

  .terminal-body :global(.t-muted) {
    color: #64748b;
  }

  .terminal-body :global(.t-ok) {
    color: #34d399;
    font-weight: 700;
  }

  .terminal-body :global(.t-add) {
    color: #38bdf8;
    font-weight: 700;
  }

  .terminal-body :global(.t-key) {
    color: #f8fafc;
    font-weight: 600;
  }

  .terminal-body :global(.t-val) {
    color: #c4b5fd;
  }

  .terminal-body :global(.t-accent) {
    color: #38bdf8;
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .replay-btn span {
      display: none;
    }

    .terminal-body {
      font-size: 0.78rem;
      padding: 1.1rem;
    }
  }
</style>
